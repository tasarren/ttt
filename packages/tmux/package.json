{
  "name": "@ttt/tmux",
  "version": "0.1.0",
  "description": "Semantic tmux API for agent teams: identity, inventory, panes, input, options, setup profiles",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "author": "tasarren",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tasarren/ttt.git",
    "directory": "packages/tmux"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "publishConfig": {
    "name": "@tasarren/tmux",
    "access": "public",
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "pnpm build && rm -f ./README.md ./LICENSE && cp ../../docs/tmux-api.md ./README.md && cp ../../LICENSE ./LICENSE",
    "postpack": "rm -f ./README.md ./LICENSE",
    "test": "node --test tests/*.test.ts"
  }
}
