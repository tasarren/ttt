# Only verification inputs enter the image; host config, Git data and scratch stay outside.
**
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!tsconfig.json
!tsconfig.base.json
!eslint.config.mjs
!README.md
!LICENSE
!packages/
!packages/**
!docs/
!docs/**
!skills/
!skills/**
!.orchestrator/
.orchestrator/**
!.orchestrator/scripts/
!.orchestrator/scripts/**
**/node_modules
**/dist
**/*.tsbuildinfo
**/.env
**/.env.*
**/.npmrc
**/.git
**/*.log
**/*.tgz
packages/cli/README.md
packages/cli/LICENSE
packages/cli/skills
packages/tmux/README.md
packages/tmux/LICENSE
