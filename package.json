{
  "name": "@ttt/workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ttt": "node packages/cli/src/ttt.ts",
    "build": "pnpm --filter @ttt/tmux build && pnpm --filter @tasarren/ttt build && pnpm --filter @ttt/ui build && pnpm --filter @ttt/webapp build",
    "typecheck": "pnpm --filter @ttt/ui build && tsc -p tsconfig.json && pnpm --filter @ttt/ui typecheck && pnpm --filter @ttt/webapp typecheck",
    "lint": "eslint .",
    "test": "pnpm --filter @ttt/ui build && node --test packages/*/tests/*.test.ts packages/ui-lib/tests/*.test.mjs",
    "check": "pnpm run version:check && pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build && pnpm --filter @ttt/ui build:stories",
    "version:check": "node scripts/sync-version.mjs",
    "version:sync": "node scripts/sync-version.mjs --write",
    "web": "pnpm --filter @ttt/webapp dev",
    "web:start": "pnpm --filter @ttt/webapp start"
  },
  "devDependencies": {
    "@eslint/js": "catalog:devTools",
    "@stylistic/eslint-plugin": "catalog:devTools",
    "@types/node": "catalog:devTools",
    "eslint": "catalog:devTools",
    "eslint-import-resolver-typescript": "catalog:devTools",
    "eslint-plugin-import-x": "catalog:devTools",
    "eslint-plugin-unused-imports": "catalog:devTools",
    "globals": "catalog:devTools",
    "tsdown": "catalog:devTools",
    "typescript": "catalog:devTools",
    "typescript-eslint": "catalog:devTools"
  },
  "dependencies": {
    "@tasarren/ttt": "link:packages/cli"
  }
}
